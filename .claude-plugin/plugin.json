{
  "name": "skimmable",
  "description": "Every Claude Code reply formatted for skimmability: short sentences, lists over paragraphs, code blocks for illustration.",
  "author": {
    "name": "Rico Sta. Cruz",
    "url": "https://github.com/rstacruz"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/skimmable-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading skimmable mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/skimmable-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking skimmable mode..."
          }
        ]
      }
    ]
  }
}
